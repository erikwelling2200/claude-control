{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"lib": ["ES2022"],
		"outDir": "out",
		"strict": true,
		"noUnusedLocals": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"exactOptionalPropertyTypes": false,
		"skipLibCheck": true,
		"sourceMap": true
	},
	"include": ["src", "tools"]
}
